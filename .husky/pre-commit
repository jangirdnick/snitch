#!/usr/bin/env sh

# Run lint-staged in each workspace package so ESLint executes from the correct
# package directory. pnpm --filter sets CWD to the package root, which ensures
# ESLint resolves the package-level eslint.config.js (with projectService) and
# not the root config — preventing the "file not found in project" parse errors.
pnpm --filter client exec lint-staged
pnpm --filter server exec lint-staged