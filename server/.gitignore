# ──────────────────────────────────────────────────────────────────────────────
# Server (Express + TypeScript) — App-Specific .gitignore
# Root .gitignore already covers: node_modules, logs, .env, OS files, IDE files,
# coverage, *.tsbuildinfo, *.pem, and all common exclusions.
# Only add rules here that are UNIQUE to the Express/Node server.
# ──────────────────────────────────────────────────────────────────────────────

# Compiled TypeScript output
dist/

# Test coverage report (generated by jest --coverage)
coverage/

# File uploads directory (if local disk storage is used in dev)
uploads/